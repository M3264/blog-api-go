# Generate with: openssl rand -hex 32
BLOG_ADMIN_TOKEN=
BLOG_DB_PASSWORD=
BLOG_ALLOWED_ORIGIN=
BLOG_CACHE_PREFIX=blog-api
# Set true for the browser test UI at /playground/.
BLOG_ENABLE_PLAYGROUND=false
# Local testing only. Keep false with a generated 32+ character token in production.
BLOG_ALLOW_SHORT_ADMIN_TOKEN=false
