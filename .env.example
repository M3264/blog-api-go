# Use a private .env or deployment secret store; never commit configured values.
BLOG_DB_PASSWORD=
BLOG_CACHE_PREFIX=blog-api
BLOG_SITE_URL=https://blog.kennyy.tech
BLOG_LEGACY_ADMIN=false
# Optional transition-only shared token (not required with legacy admin disabled).
BLOG_ADMIN_TOKEN=
BLOG_ALLOW_SHORT_ADMIN_TOKEN=false
# Compose sets /app/media; host deployments can use data/media.
BLOG_MEDIA_DIR=data/media
BLOG_EMAIL_FROM=blog@kennyy.tech
# Host-local Postfix: 127.0.0.1:25 with mode=local. Leave blank for Resend.
# Containers need an accessible authenticated TLS relay, not host loopback.
BLOG_SMTP_ADDR=
BLOG_SMTP_MODE=starttls
BLOG_SMTP_USER=
BLOG_SMTP_PASSWORD=
# Private bootstrap recipient; public registration always creates readers.
BLOG_INITIAL_ADMIN_EMAIL=
RESEND_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# For a host Go process, set BLOG_DATABASE_URL and BLOG_REDIS_URL privately.
